# Supabase connection
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Experiment configuration
VITE_EXPERIMENT_ID=concurrent_operants_counterbalanced_v1
VITE_APP_VERSION=0.1.0
VITE_DEBUG_LOCAL_ONLY=false
VITE_DEFAULT_SEED=
VITE_POINTS_PER_REINFORCER=1

# Assignment configuration
ASSIGNMENT_RESERVATION_MINUTES=30
TARGET_N_PER_ORDER=5

# Server-side only (Vercel environment variables, never exposed to browser)
SUPABASE_SERVICE_ROLE_KEY=

# CORS origin for the /api/assign-order endpoint (defaults to '*' if unset)
# Set to your production domain in production, e.g. https://your-app.vercel.app
CORS_ALLOWED_ORIGIN=
